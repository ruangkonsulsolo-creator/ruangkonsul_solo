# Salin ke .env.local lalu isi nilainya. JANGAN commit .env.local.

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# true = semua halaman bisa dibuka tanpa login (data dummy). Kosongkan / false di production.
NEXT_PUBLIC_PREVIEW_MODE=false

# ── Supabase (Project Settings → API) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rahasia! Hanya dipakai di server (webhook, pembuatan pesanan/pembayaran).
SUPABASE_SERVICE_ROLE_KEY=

# ── Midtrans (Dashboard → Settings → Access Keys) ────────────────────
# Sandbox: SB-Mid-server-... / SB-Mid-client-...
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ── Referral ─────────────────────────────────────────────────────────
REFERRAL_COMMISSION_PERCENT=10

# ── Notifikasi (opsional) ────────────────────────────────────────────
FONNTE_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Merchandise ──────────────────────────────────────────────────────
NEXT_PUBLIC_MERCH_SHIPPING_FEE=15000

# ── Engine layanan (Parafrase, AI Checker, Similarity) ──────────────
# Wajib untuk parafrase; AI checker tetap jalan tanpa ini (stilometri saja)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PARAPHRASE=claude-sonnet-5-5
ANTHROPIC_MODEL_DETECT=claude-haiku-5-5
PARAPHRASE_MAX_WORDS=10000
AI_DETECT_MAX_SEGMENTS=40
# Similarity: pencarian web Google via serper.dev (opsional, tanpa ini: repositori + OpenAlex)
SERPER_API_KEY=
SIMILARITY_MAX_QUERIES=20
# Email kontak untuk OpenAlex "polite pool" (lebih cepat & stabil)
OPENALEX_MAILTO=
# false = jangan simpan fingerprint dokumen ke repositori internal
SIMILARITY_REPOSITORY=true

# ── Cron & keamanan ──────────────────────────────────────────────────
# String acak panjang; Vercel Cron mengirimnya sebagai Bearer token
CRON_SECRET=
# true = CSP hanya melapor (uji awal), false/kosong = CSP aktif memblokir
CSP_REPORT_ONLY=false
