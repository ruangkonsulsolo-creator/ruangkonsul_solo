# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RAHASIA — hanya server (webhook Midtrans, checkout, receipt). Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://ruangkonsulsolo.id

# ── Pemeriksaan naskah ──────────────────────────────────────────────────────
#
# Fitur ini mati sampai penyedia dipilih dan dikonfigurasi.
#
# PERIKSA_PENYEDIA=http mengaktifkan pemanggilan API. Sebelum itu, isi dulu
# petakanKemiripan() dan petakanAI() di lib/periksa/penyedia.ts sesuai
# dokumentasi penyedia yang kamu pakai.
PERIKSA_PENYEDIA=
PERIKSA_API_URL=
PERIKSA_API_KEY=
PERIKSA_NAMA=

# Menentukan logo penyedia yang tampil di antarmuka. Isi HANYA dengan
# penyedia yang benar-benar menjalankan pemeriksaan — memasang logo merek
# yang tidak dipakai menyesatkan pembeli.
#
# Nilai yang dikenali: gptzero, copyleaks, winston, plagiarismcheck,
# originality. Lihat lib/periksa/daftar-penyedia.ts.
NEXT_PUBLIC_PERIKSA_PENYEDIA_KEMIRIPAN=
NEXT_PUBLIC_PERIKSA_PENYEDIA_AI=

# ── Pembayaran ──────────────────────────────────────────────────────────────
# Sandbox: SB-Mid-server-... / SB-Mid-client-...  (Midtrans Dashboard → Settings → Access Keys)
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Opsional: "Signature Secret Key" (dashboard Midtrans baru → Access Keys → General Credentials)
MIDTRANS_SIGNATURE_KEY=
# "true" hanya saat go-live dengan key production
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
# Ongkir flat (Rp) untuk produk fisik (merchandise) di checkout katalog
NEXT_PUBLIC_ONGKIR_FLAT=15000

# ── Notifikasi ──────────────────────────────────────────────────────────────
FONNTE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# PERIKSA NASKAH — tiap fitur boleh memakai penyedia berbeda
# ─────────────────────────────────────────────────────────────────────────────

# ── Cek Indikasi AI: GPTZero ────────────────────────────────────────────────
# Kunci diambil dari dasbor GPTZero (Settings -> API).
PERIKSA_PENYEDIA_AI=gptzero
GPTZERO_API_KEY=
# Menyalakan logo GPTZero di antarmuka. Hanya setel kalau GPTZero memang
# yang menjalankan pemeriksaannya — logo penyedia yang tidak dipakai
# menyesatkan pembeli.
NEXT_PUBLIC_PERIKSA_PENYEDIA_AI=gptzero

# ── Parafrase: model bahasa mana pun yang bentuk API-nya ala OpenAI ─────────
# Gemini (paling murah saat ini):
PARAFRASE_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
PARAFRASE_MODEL=gemini-2.5-flash-lite
# OpenAI:     https://api.openai.com/v1/chat/completions   + gpt-4o-mini
# OpenRouter: https://openrouter.ai/api/v1/chat/completions
PARAFRASE_API_KEY=

# ── Cek Plagiarisme: vendor belum dipilih ───────────────────────────────────
# Isi setelah memilih vendor (Copyleaks / PlagiarismCheck.org / Originality.ai),
# lalu lengkapi petakanKemiripan() di lib/periksa/penyedia.ts sesuai bentuk
# tanggapan vendor itu. Jangan menebak bentuknya.
KEMIRIPAN_API_URL=
KEMIRIPAN_API_KEY=
KEMIRIPAN_NAMA=
