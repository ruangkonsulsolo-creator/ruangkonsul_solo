# Salin ke .env.local lalu isi nilainya. JANGAN commit .env.local.

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# true = semua halaman bisa dibuka tanpa login (data dummy). Kosongkan / false di production.
NEXT_PUBLIC_PREVIEW_MODE=false

# ── Supabase (Project Settings → API) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rahasia! Hanya dipakai di server (webhook, pembuatan pesanan/pembayaran).
SUPABASE_SERVICE_ROLE_KEY=

# ── Midtrans (Dashboard → Settings → Access Keys) ────────────────────
# Sandbox: SB-Mid-server-... / SB-Mid-client-...
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ── Referral ─────────────────────────────────────────────────────────
REFERRAL_COMMISSION_PERCENT=10

# ── Notifikasi (opsional) ────────────────────────────────────────────
FONNTE_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
