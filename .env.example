# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Pemeriksaan naskah ──────────────────────────────────────────────────────
#
# Fitur ini mati sampai penyedia dipilih dan dikonfigurasi.
#
# PERIKSA_PENYEDIA=http mengaktifkan pemanggilan API. Sebelum itu, isi dulu
# petakanKemiripan() dan petakanAI() di lib/periksa/penyedia.ts sesuai
# dokumentasi penyedia yang kamu pakai.
PERIKSA_PENYEDIA=
PERIKSA_API_URL=
PERIKSA_API_KEY=
PERIKSA_NAMA=

# Menentukan logo penyedia yang tampil di antarmuka. Isi HANYA dengan
# penyedia yang benar-benar menjalankan pemeriksaan — memasang logo merek
# yang tidak dipakai menyesatkan pembeli.
#
# Nilai yang dikenali: gptzero, copyleaks, winston, plagiarismcheck,
# originality. Lihat lib/periksa/daftar-penyedia.ts.
NEXT_PUBLIC_PERIKSA_PENYEDIA_KEMIRIPAN=
NEXT_PUBLIC_PERIKSA_PENYEDIA_AI=

# ── Pembayaran ──────────────────────────────────────────────────────────────
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# ── Notifikasi ──────────────────────────────────────────────────────────────
FONNTE_API_KEY=
